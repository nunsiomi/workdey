{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {},
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "status",
                    "score",
                    "title",
                    "company",
                    "location",
                    "source",
                    "sourceCategory",
                    "postedAt",
                    "verifyManually",
                    "url"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "status": { "label": "Status", "format": "text" },
                    "score": { "label": "Fit score", "format": "number" },
                    "title": { "label": "Title", "format": "text" },
                    "company": { "label": "Company / poster", "format": "text" },
                    "location": { "label": "Location", "format": "text" },
                    "source": { "label": "Source", "format": "text" },
                    "sourceCategory": { "label": "Source type", "format": "text" },
                    "postedAt": { "label": "Posted", "format": "date" },
                    "verifyManually": { "label": "Verify manually", "format": "boolean" },
                    "url": { "label": "Original link", "format": "link" }
                }
            }
        }
    }
}
